{
  "manifest_version": 3,
  "name": "Tab Triage",
  "version": "2.0.0",
  "description": "Every open Safari tab, sorted into folders by site. Check, close in one action, undo for a minute. Save and restore sessions.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Triage",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "lib/grouping.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://github.com/jhotzfoto/tab-triage",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
